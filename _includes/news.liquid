<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="table-responsive">
      <table class="table table-borderless align-middle m-0">
        {% assign news = site.news | reverse %}
        {% for item in news %}
          <tr class="d-flex align-items-center mb-4">
            
            <!-- Column 1: Forced Large Image -->
            <td class="p-0 me-4" style="flex: 0 0 260px; max-width: 260px;">
              {% if item.image %}
                <img
                  src="{{ item.image | relative_url }}"
                  class="img-fluid rounded z-depth-1"
                  alt="news thumbnail"
                  style="width: 260px; height: 170px; object-fit: cover; display: block;"
                >
              {% endif %}
            </td>

            <!-- Column 2: News Text Content -->
            <td class="p-0" style="flex: 1;">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title font-weight-bold" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>

          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
